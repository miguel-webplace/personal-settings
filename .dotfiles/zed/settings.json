{

  "markdown_preview": {
    "font_family": "DejaVu Serif"
  },
  "window_decorations": "server",
  "bottom_dock_layout": "contained",
  "preview_tabs": {
    "enabled": true
  },
  "tabs": {
    "file_icons": false
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "show_branch_status_icon": true
  },
  "debugger": {
    "button": false
  },
  "search": {
    "button": false
  },
  "terminal": {
    "copy_on_select": true,
    "font_weight": 500.0,
    "button": false
  },
  "status_bar": {
    "show_active_file": false,
    "cursor_position_button": false,
    "active_language_button": true
  },
  "text_rendering_mode": "platform_default",
  "image_viewer": {
    "unit": "decimal"
  },
  "word_diff_enabled": false,
  "use_on_type_format": false,
  "scrollbar": {
    "diagnostics": "error",
    "selected_symbol": false,
    "search_results": true,
    "git_diff": false
  },
  "inline_code_actions": false,
  "icon_theme": "Zed (Default)",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "cli_default_open_behavior": "new_window",
  "drop_target_size": 2.2,
  "message_editor": {
    "auto_replace_emoji_shortcode": false
  },
  "toolbar": {
    "code_actions": false,
    "agent_review": false,
    "selections_menu": true,
    "quick_actions": false
  },
  "hover_popover_enabled": true,
  "minimum_contrast_for_highlights": 60.0,
  "unnecessary_code_fade": 0.5,
  "cursor_shape": "bar",
  "remove_trailing_whitespace_on_save": false,
  "format_on_save": "off",
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "show_edit_predictions": false,
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "enable_feedback": false
  },
  "formatter": "none",

  "colorize_brackets": false,
  "inlay_hints": {
    "show_parameter_hints": false,
    "show_type_hints": false,
    "show_value_hints": false,
    "enabled": true,
  },

  "hard_tabs": false,
  "drag_and_drop_selection": {
    "enabled": false,
  },

  "hover_popover_delay": 500,
  "diff_view_style": "unified",
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },

  "session": {
    "trust_all_worktrees": true,
  },

  "completions": {
    "words_min_length": 4,
    "words": "enabled",
    "lsp": true,
  },

  "ui_font_size": 16,
  "ui_font_family": ".ZedMono",
  "ui_font_weight": 600,

  "buffer_font_size": 16,
  "buffer_font_weight": 600,

  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Hard",
    "dark": "Catppuccin Mocha - No Italics",
  },

  "languages": {
    "JSON": {
      "auto_indent": "syntax_aware",

      "show_whitespaces": "all",
      "whitespace_map": {
        "space": "•",
      },
    },

    "Python": {
      "auto_indent": "syntax_aware",

      "language_servers": ["ruff", "ty"],
      "show_whitespaces": "all",
      "whitespace_map": {
        "space": "•",
      },
    },

    "C": {
      "auto_indent": "syntax_aware",

      "show_whitespaces": "all",
      "whitespace_map": {
        "space": "•",
      },
    },
  },

  "indent_guides": {
    "line_width": 3,
    "active_line_width": 3,
    "coloring": "fixed",
  },

  "extend_comment_on_newline": false,

  "file_types": {
    "C": ["c", "h"],
  }
}
